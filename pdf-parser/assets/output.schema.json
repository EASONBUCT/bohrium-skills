{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PdfParseOutput",
  "description": "Structured parse produced by scripts/parse_pdf.py",
  "type": "object",
  "required": ["source", "parser", "num_pages", "blocks"],
  "properties": {
    "source": {"type": "string"},
    "parser": {"type": "string"},
    "has_text_layer": {"type": "boolean"},
    "num_pages": {"type": "integer"},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "page", "bbox"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["title", "heading", "paragraph", "caption", "equation", "table", "reference", "margin", "empty"]},
          "text": {"type": "string"},
          "page": {"type": "integer"},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "order": {"type": "integer"}
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "title", "page"],
        "properties": {
          "id": {"type": "string"},
          "level": {"type": "integer"},
          "title": {"type": "string"},
          "page": {"type": "integer"},
          "bbox": {"type": "array", "items": {"type": "number"}}
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page"],
        "properties": {
          "id": {"type": "string"},
          "page": {"type": "integer"},
          "bbox": {"type": "array", "items": {"type": "number"}},
          "grid": {
            "type": "object",
            "properties": {
              "columns": {"type": "integer"},
              "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
            }
          },
          "kind": {"enum": ["text", "image"]}
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {"type": "object", "properties": {"id": {"type": "string"}, "caption": {"type": "string"}, "page": {"type": "integer"}}}
    },
    "equations": {
      "type": "array",
      "items": {"type": "object", "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "page": {"type": "integer"}}}
    },
    "references": {
      "type": "array",
      "items": {"type": "object", "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "page": {"type": "integer"}}}
    }
  }
}

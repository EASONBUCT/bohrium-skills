{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeckOutline",
  "description": "Claim-first deck outline consumed by scripts/build_pptx.py",
  "type": "object",
  "required": ["case_id", "paper_title", "slides"],
  "properties": {
    "case_id": {"type": "string"},
    "paper_title": {"type": "string"},
    "audience": {"type": "string"},
    "time_minutes": {"type": "number"},
    "max_slides": {"type": "integer", "minimum": 1},
    "narrative": {
      "type": "object",
      "properties": {
        "question": {"type": "string"},
        "approach": {"type": "string"},
        "key_results": {"type": "array", "items": {"type": "string"}},
        "conclusion": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "claim", "bullets"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "claim": {"type": "string", "minLength": 1},
          "bullets": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref", "kind", "page"],
              "properties": {
                "ref": {"type": "string"},
                "kind": {"enum": ["figure", "table", "equation", "section", "data"]},
                "page": {"type": "integer", "minimum": 1},
                "caption": {"type": "string"},
                "quote": {"type": "string"}
              }
            }
          },
          "speaker_note": {"type": "string"},
          "transition": {"type": "string"},
          "image": {"type": "string", "description": "Optional path to a figure image file"},
          "layout": {"enum": ["title", "bullets", "bullets_figure", "figure", "table", "section"]}
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KgBuilderGraph",
  "description": "Evidence-bound knowledge graph produced by scripts/build_graph.py",
  "type": "object",
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": {"type": "string"},
    "corpus": {
      "type": "object",
      "properties": {
        "sources": {"type": "array", "items": {"type": "object"}},
        "note": {"type": "string"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "mentions"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["researcher", "material", "method", "task", "metric", "conclusion"]},
          "label": {"type": "string"},
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "paragraph_id", "quote"],
              "properties": {
                "source_id": {"enum": ["primary", "secondary"]},
                "paragraph_id": {"type": "string"},
                "quote": {"type": "string"},
                "surface": {"type": "string"}
              }
            }
          },
          "merged_from": {"type": "array", "items": {"type": "string"}},
          "merge_justification": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "target", "direction"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["uses", "compares", "outperforms", "supports", "contradicts", "proposes"]},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "direction": {"type": "string"},
          "condition": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "paragraph_id", "quote", "strength"],
              "properties": {
                "source_id": {"enum": ["primary", "secondary"]},
                "paragraph_id": {"type": "string"},
                "quote": {"type": "string"},
                "strength": {"enum": ["direct", "inferred"]}
              }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"enum": ["same-name-different-object", "contradicting-relations", "other"]},
          "nodes": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
